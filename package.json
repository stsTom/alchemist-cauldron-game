      "prettier --write"
    ],
    "*.{json,css,html,md}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
